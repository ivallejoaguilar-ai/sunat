# ============================================
# VARIABLES DE ENTORNO PARA RAILWAY
# ============================================
# Copia estas variables en Railway Dashboard
# Settings > Variables
# ============================================

# APP
APP_NAME="API Facturación SUNAT"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Lima
APP_URL=https://tu-app.up.railway.app

# Genera una nueva key con: php artisan key:generate --show
APP_KEY=base64:GENERA_UNA_NUEVA_KEY_AQUI

# DATABASE (Railway te dará estos valores automáticamente)
# Si usas MySQL de Railway, estas variables se auto-configuran
DB_CONNECTION=mysql
DB_HOST=${MYSQL_HOST}
DB_PORT=${MYSQL_PORT}
DB_DATABASE=${MYSQL_DATABASE}
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# QUEUE & CACHE
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# SUNAT CREDENTIALS (Actualiza con tus datos reales)
SUNAT_USER_SOL=20123456789MODDATOS
SUNAT_PASS_SOL=C4mb14m3@
SUNAT_ENDPOINT_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_ENDPOINT_PRODUCCION=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# CERTIFICADO (Subirás el archivo después)
# La contraseña del certificado
CERTIFICADO_PASSWORD=C4mb14m3@

# SANCTUM
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=sunat_

# LOG
LOG_CHANNEL=stack
LOG_LEVEL=info

# MAIL (Opcional - para notificaciones)
MAIL_MAILER=log
